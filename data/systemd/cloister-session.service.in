[Unit]
Description=Cloister session service
Documentation=https://github.com/axel7083/cloister

[Service]
Type=dbus
BusName=io.github.axel7083.Cloister.Session
ExecStart=@libexecdir@/cloister-session
# SIGTERM to cloister-session only: it unmounts every vault, then gocryptfs exits.
KillMode=mixed
TimeoutStopSec=20
Restart=no
# Deliberately NOT set, checked by tests/check-session-unit.sh:
# - NoNewPrivileges, and every seccomp-based option (SystemCallFilter,
#   SystemCallArchitectures, LockPersonality, RestrictRealtime,
#   MemoryDenyWriteExecute...): in a *user* unit they imply NoNewPrivileges,
#   which breaks the setuid fusermount3 that mounts the vault;
# - every namespacing option (ProtectSystem, PrivateTmp, ProtectHome...): a
#   private mount namespace would hide the unlocked vault from applications.
UMask=0077
