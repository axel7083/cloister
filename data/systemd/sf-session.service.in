[Unit]
Description=Secure Folder session service
Documentation=https://github.com/axel7083/secure-folder

[Service]
Type=dbus
BusName=io.github.axel7083.SecureFolder.Session
ExecStart=@libexecdir@/sf-session
# SIGTERM to sf-session only: it unmounts every vault, then gocryptfs exits.
KillMode=mixed
TimeoutStopSec=20
Restart=no
# Deliberately NOT set: NoNewPrivileges (fusermount3 is setuid) and every
# namespacing option (ProtectSystem, PrivateTmp, ProtectHome...): a private
# mount namespace would hide the unlocked vault from the user's applications.
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077
